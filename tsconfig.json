{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "isolatedModules": true,

    "allowJs": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,

    "jsx": "react-jsx",

    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    },

    // 🔥 CRITICAL FIX
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "."
  },

  "include": [
    "server.ts",
    "prisma.config.ts",
    "src"
  ],

  "exclude": ["node_modules", "dist"]
}
